model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	maxParallelismPerRefresh: 3
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Update","Q - Pre booking","M - Measures","Q - Occupancy","Q - Daily stats"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation __TEdtr = 1

annotation PBI_ProTooling = ["DevMode"]

ref table Update
ref table 'Q - Pre booking'
ref table 'M - Measures'
ref table 'Q - Occupancy'
ref table 'P - Fields occupancy'
ref table 'P - Measures occupancy'
ref table 'P - City'
ref table 'Q - Daily stats'
ref table 'C - Calendar'
ref table 'Dynamic Date Selection'
ref table 'Dynamic Date Selection Order'
ref table 'P - Measures daily stats'
ref table 'D - Metrics name'
ref table 'P - Occupancy'

ref cultureInfo en-US

