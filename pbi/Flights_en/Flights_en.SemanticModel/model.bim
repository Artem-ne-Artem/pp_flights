        "partitions": [
          {
            "name": "Q - Pre booking",
            "mode": "import",
            "source": {
              "expression": [
                "// let",
                "//     Источник = PostgreSQL.Database(\"localhost\", \"flights\"),",
                "//     rep_bookings_pre_booking = Источник{[Schema=\"rep_bookings\",Item=\"pre_booking\"]}[Data]",
                "// in",
                "//     rep_bookings_pre_booking",
                "",
                "",
                "let",
                "    Источник = PostgreSQL.Database(\"194.87.190.4:5432\", \"default_db\"),",
                "    dbt_rep_occupancy = Источник{[Schema=\"dbt_rep\",Item=\"pre_booking\"]}[Data]",
                "in",
                "    dbt_rep_occupancy"
              ],
              "type": "m"
            }
          }
        ]
