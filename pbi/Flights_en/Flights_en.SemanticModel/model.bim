            "lineageTag": "3b6f3169-6575-4ba9-a243-5b59f0d146f4",
            "sortByColumn": "Departure mon num",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Generation",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "expression": [
              "DATEDIFF('Q - Pre booking'[book_dt], 'Q - Pre booking'[scheduled_departure_dt], MONTH)",
              "// IF(",
              "//     'Q - Pre booking'[Departure mon num] >= 'Q - Pre booking'[Book mon num]",
              "//     ,'Q - Pre booking'[Departure mon num] - 'Q - Pre booking'[Book mon num]",
              "//     ,'Q - Pre booking'[Book mon num] - 'Q - Pre booking'[Departure mon num]",
              "// )"
            ],
            "formatString": "0",
            "isDataTypeInferred": true,
            "lineageTag": "01b7e901-2343-441f-8595-15564a04ea3e",
            "summarizeBy": "sum",
            "type": "calculated"
          }
        ],
