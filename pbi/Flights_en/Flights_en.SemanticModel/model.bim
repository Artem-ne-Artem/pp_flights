        "lineageTag": "989a7253-d911-4f61-ad86-03777cde8ffa",
        "partitions": [
          {
            "name": "Dynamic Date Selection",
            "mode": "import",
            "source": {
              "expression": [
                "",
                "SELECTCOLUMNS(",
                "    UNION(",
                "        ADDCOLUMNS(",
                "            'C - Calendar'",
                "            ,\"Axis date\" ,FORMAT([Date], \"dd.mm\")",
                "            ,\"Type\" ,\"Day\"",
                "            ,\"Order\" ,1",
                "        )",
                "        ,ADDCOLUMNS(",
                "            'C - Calendar'",
                "            ,\"Axis date\" ,FORMAT([Date] - WEEKDAY([Date], 2) + 1, \"dd.mm\") & \" - \" & FORMAT([Date] - WEEKDAY([Date], 2) + 7, \"dd.mm\")",
                "            ,\"Type\" ,\"Week\"",
                "            ,\"Order\" ,2",
                "        )",
                "        ,ADDCOLUMNS(",
                "            'C - Calendar'",
                "            ,\"Axis date\" ,FORMAT([Date], \"mm.yy\")",
                "            ,\"Type\" ,\"Month\"",
                "            ,\"Order\" ,3",
                "        )",
                "        ,ADDCOLUMNS(",
                "            'C - Calendar'",
                "            ,\"Axis date\" ,YEAR([Date])",
                "            ,\"Type\" ,\"Year\"",
                "            ,\"Order\" ,4",
                "        )",
                "    )",
                "    ,\"Date\" ,[Date]",
                "    ,\"Axis date\" ,[Axis date]",
                "    ,\"Type\" ,[Type]",
                "    ,\"Order\" ,[Order]",
                ")"
              ],
              "type": "calculated"
            }
          }
        ]
